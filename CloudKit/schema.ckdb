DEFINE SCHEMA

    // The record types NSPersistentCloudKitContainer mirrors Store.model into: entity Foo becomes CD_Foo and
    // attribute bar becomes CD_bar. Strings and binary data can spill into a CD_<name>_ckAsset when large.
    // Change this alongside Store.model, import it to Development (CKTool), then Deploy Schema Changes in
    // CloudKit Console; TestFlight and App Store builds only sync against the deployed Production schema.

    RECORD TYPE CD_Tracked (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_tmdbID               INT64,
        CD_mediaTypeRaw         STRING,
        CD_mediaTypeRaw_ckAsset ASSET,
        CD_statusRaw            STRING,
        CD_statusRaw_ckAsset    ASSET,
        CD_name                 STRING,
        CD_name_ckAsset         ASSET,
        CD_posterPath           STRING,
        CD_posterPath_ckAsset   ASSET,
        CD_backdropPath         STRING,
        CD_backdropPath_ckAsset ASSET,
        CD_releaseDate          STRING,
        CD_releaseDate_ckAsset  ASSET,
        CD_rating               INT64,
        CD_runtime              INT64,
        CD_addedAt              TIMESTAMP,
        CD_watchedAt            TIMESTAMP,
        CD_position             INT64,
        CD_note                 STRING,
        CD_note_ckAsset         ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WatchedEpisode (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_showID               INT64,
        CD_season               INT64,
        CD_episode              INT64,
        CD_runtime              INT64,
        CD_watchedAt            TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Marathon (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_uuid                 STRING,
        CD_uuid_ckAsset         ASSET,
        CD_name                 STRING,
        CD_name_ckAsset         ASSET,
        CD_piecesData           BYTES,
        CD_piecesData_ckAsset   ASSET,
        CD_daysData             BYTES,
        CD_daysData_ckAsset     ASSET,
        CD_breakMinutes         INT64,
        CD_runOver              INT64,
        CD_createdAt            TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MovieNight (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_uuid                 STRING,
        CD_uuid_ckAsset         ASSET,
        CD_tmdbID               INT64,
        CD_name                 STRING,
        CD_name_ckAsset         ASSET,
        CD_posterPath           STRING,
        CD_posterPath_ckAsset   ASSET,
        CD_backdropPath         STRING,
        CD_backdropPath_ckAsset ASSET,
        CD_runtime              INT64,
        CD_showtime             TIMESTAMP,
        CD_cinema               STRING,
        CD_cinema_ckAsset       ASSET,
        CD_address              STRING,
        CD_address_ckAsset      ASSET,
        CD_screen               STRING,
        CD_screen_ckAsset       ASSET,
        CD_seats                STRING,
        CD_seats_ckAsset        ASSET,
        CD_booked               INT64,
        CD_bookedBy             STRING,
        CD_bookedBy_ckAsset     ASSET,
        CD_createdAt            TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_NightNote (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        CD_entityName           STRING,
        CD_uuid                 STRING,
        CD_uuid_ckAsset         ASSET,
        CD_authorID             STRING,
        CD_authorID_ckAsset     ASSET,
        CD_authorName           STRING,
        CD_authorName_ckAsset   ASSET,
        CD_text                 STRING,
        CD_text_ckAsset         ASSET,
        CD_rating               INT64,
        CD_createdAt            TIMESTAMP,
        // The to-one relationship, stored as the night's record name.
        CD_night                STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        roles                   LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
